# --- Admin server ---
ADMIN_PORT=8081

# HTTP Basic auth (required). The browser prompts for these.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- TMDB (themoviedb.org) ---
# v3 API key (required to enable importing).
TMDB_API_KEY=
# Both languages are retained; the fallback also fills empty legacy fields.
TMDB_LANGUAGE=vi-VN
TMDB_FALLBACK_LANGUAGE=en-US
# Gradually refresh existing titles until both locale rows exist. Set 0 to disable.
TMDB_TRANSLATION_BACKFILL_INTERVAL_MIN=1

# --- YTS (used by the crawl jobs at /crawl) ---
# yts.mx itself is dead (NXDOMAIN); this points at a working mirror. Mirrors
# rotate over time, so update this if crawling starts failing with DNS errors.
YTS_BASE_URL=https://movies-api.accel.li/api/v2

# --- Crawl schedule ---
# Besides the manual buttons at /crawl, each job runs on its own interval
# (minutes; 0 disables). The first run is one interval after startup, a tick is
# skipped while that job is already running, and scheduled runs fetch no subtitles.
CRAWL_YTS_INTERVAL_MIN=720
CRAWL_YTS_LIMIT=20
CRAWL_TOP_RATED_INTERVAL_MIN=2880
CRAWL_TOP_RATED_START_PAGE=1
CRAWL_TOP_RATED_END_PAGE=5

# --- MySQL ---
# Either set the individual DB_* values or a full MYSQL_DSN (which overrides them).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=phimtor
DB_PASSWORD=phimtor
DB_NAME=phimtor
# MYSQL_DSN=phimtor:phimtor@tcp(127.0.0.1:3306)/phimtor?parseTime=true&charset=utf8mb4

# Used by docker-compose for the MySQL container's root password.
MYSQL_ROOT_PASSWORD=root

# --- Streamer manager (control plane) ---
# Base URL of the manager. The admin calls it server-side (behind basic auth) to
# add/list/get/delete torrents; the browser never talks to it. The manager
# returns each torrent's owning streamer public URL, which the browser uses for
# stats/stream directly. MANAGER_INTERNAL_TOKEN is the shared bearer the admin
# sends (must match the manager's MANAGER_INTERNAL_TOKEN); empty disables it.
MANAGER_INTERNAL_URL=http://localhost:8083
MANAGER_INTERNAL_TOKEN=

# How often (minutes) the background harvester backfills stored .torrent files
# for magnet-only sources, from the metainfo streamers have already resolved for
# live torrents — so the next play of that source skips the slow DHT metadata
# fetch. 0 disables the harvester (the manual "Lấy .torrent" button still works).
TORRENT_HARVEST_INTERVAL_MIN=5

# --- OpenSubtitles (subtitle search on the watch page) ---
# v1 API key — required to enable subtitle search/download.
OPENSUBTITLES_API_KEY=
# User-Agent sent to the OpenSubtitles API (your app name + version).
OPENSUBTITLES_USER_AGENT=phimtor2 v1.0
# Optional login — raises the per-day download quota.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- SubSource (alternative subtitle source, subsource.net) ---
# API key from your subsource.net account (sent in the X-API-Key header).
# When set, "SubSource" appears as a provider in the subtitle search UI.
SUBSOURCE_API_KEY=
# User-Agent sent to the SubSource API (your app name + version).
SUBSOURCE_USER_AGENT=phimtor2 v1.0

# --- Subtitle storage ---
# Where saved subtitle files are written: "local" (filesystem) or "s3"
# (S3-compatible object storage). Subtitles are downloaded once and persisted.
SUBTITLE_STORAGE_BACKEND=local
# local backend: directory for the .vtt files (gitignored under data/).
SUBTITLE_STORAGE_DIR=./data/subtitles
# s3 backend (only used when SUBTITLE_STORAGE_BACKEND=s3; S3_BUCKET must be set).
# For MinIO use the host:port endpoint and S3_USE_SSL=false.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
