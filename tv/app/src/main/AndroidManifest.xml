<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app is sideloaded, so it updates itself (update/Updater.kt). Android
         still asks the person to allow it once, per app, in the TV's settings,
         and still refuses any update not signed with this app's own key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- A television app, and it asks for no touchscreen because a remote has
         none. It is sideloaded, not published: the package installer does NOT
         enforce uses-feature (only a store's filtering does), so these declare
         intent rather than gate installs. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".PhimnetApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:targetApi="33">

        <!-- No backup and no device-to-device transfer: the settings store holds
             the paired TV's bearer token, and a copy restored onto another device
             would carry a live credential for somebody's account with it. From
             Android 12, allowBackup="false" no longer stops device transfer on its
             own, hence dataExtractionRules (see xml/data_extraction_rules.xml). -->

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The PackageInstaller session's outcome; only the system sends it. -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />
    </application>
</manifest>
