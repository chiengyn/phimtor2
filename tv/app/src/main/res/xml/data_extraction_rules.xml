<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves this device: not to a cloud backup, and not to a new device
  during setup. The settings store holds the paired TV's bearer token, and a
  restored copy on another television would carry a live credential for
  somebody's account that the account holder never paired.

  allowBackup="false" alone is not enough from Android 12: it stops cloud backup
  but NOT device-to-device transfer. These rules close both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
